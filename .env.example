# Copy this file to .env and fill in your credentials.
# run_benchmark.py auto-loads .env. CLI flags override these values.

# --- Subject model provider (e.g. wandb inference for GLM 5.2) ---
SUBJECT_API_KEY=
# OpenAI project header, required by wandb inference for usage attribution.
# Format: team/project. Leave blank if your provider does not need it.
SUBJECT_PROJECT=team/project

# --- Evaluator model provider (e.g. OpenRouter for Mistral) ---
EVALUATOR_API_KEY=
# Optional; only sent when set.
EVALUATOR_PROJECT=
